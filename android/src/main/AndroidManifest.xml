<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the plugin detect whether Health Connect is installed (Android 13 and below).
         Data permissions (android.permission.health.READ_*) are declared by the app. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
